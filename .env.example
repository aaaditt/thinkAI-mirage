# Copy to .env and fill in. Never commit .env.

# Optional: Azure OpenAI for the City agent. Leave empty to use the rule-based planner.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Optional. Defaults to 2024-10-21.
AZURE_OPENAI_API_VERSION=

# Multiplier applied to the historical rainfall record (1.0 = as recorded).
RAIN_SCALE=1.0

# Grid cell size in metres. Changing it requires re-running the data fetch.
CELL_SIZE_M=200
